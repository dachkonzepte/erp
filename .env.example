# Auf dem Produktivserver gesetzt (siehe CLAUDE.md "Produktivbetrieb") -- schaltet u. a.
# Base.metadata.create_all() beim Start ab, damit dort ausschließlich die Migrationskette
# (alembic upgrade head) über das Datenbankschema entscheidet, nicht zusätzlich ein
# Sicherheitsnetz, das eine fehlende Migration unbemerkt verdecken könnte. Lokal leer
# lassen (Standard: "development", create_all() bleibt aktiv):
# ERP_ENV=production

# Für den schnellen lokalen Prototyp kann SQLite verwendet werden:
DATABASE_URL=sqlite:///./dachkonzepte_erp.db

# Für PostgreSQL (lokal, z. B. mit Docker, oder auf dem Produktivserver) stattdessen:
# DATABASE_URL=postgresql+psycopg://dachkonzepte:dachkonzepte@localhost:5432/dachkonzepte_erp
#
# WICHTIG: das Präfix muss "postgresql+psycopg" lauten, NICHT "postgresql+psycopg2" --
# requirements.txt installiert ausschließlich psycopg (Version 3, SQLAlchemy-Dialektname
# "psycopg"), nicht das ältere, separate Paket psycopg2. "+psycopg2" in der
# Verbindungszeichenfolge führt zu einem Importfehler, sobald SQLAlchemy den (hier gar
# nicht installierten) psycopg2-Treiber laden will -- real so auf dem Produktivserver
# passiert, siehe CLAUDE.md "Produktivbetrieb".

# Zugangsdaten für den Postgres-Container aus docker-compose.yml (nur wenn
# Postgres genutzt wird). Ohne diese Datei/Werte gelten dieselben Vorgaben
# wie bisher (dachkonzepte/dachkonzepte) -- für einen echten Server hier
# eigene, nicht öffentlich geteilte Werte eintragen:
# POSTGRES_DB=dachkonzepte_erp
# POSTGRES_USER=dachkonzepte
# POSTGRES_PASSWORD=dachkonzepte

# Cookie nur über HTTPS senden (z. B. hinter einem Reverse-Proxy). Bei
# reinem HTTP unbedingt auf 0/aus lassen, sonst funktioniert der Login nicht:
# ERP_COOKIE_SECURE=1

# Schlüssel zur Verschlüsselung sensibler Zugangsdaten (SMTP-Passwort,
# Microsoft-365-Client-Secret) in der Datenbank. Lokal wird ohne diese
# Variable automatisch ein Schlüssel in data/.erp_secret erzeugt -- auf
# einem echten Server MUSS stattdessen diese Variable gesetzt werden (fester,
# eigener Wert, z. B. mit "python -c \"import secrets; print(secrets.token_hex(32))\""
# erzeugt), sonst werden bereits verschlüsselte Werte nach einem Neustart/
# Redeploy unlesbar, sobald data/ nicht dauerhaft erhalten bleibt:
# ERP_SECRET_KEY=

# Verzeichnis für den Verschlüsselungsschlüssel (.erp_secret), das Log
# (erp.log) und alle Upload-Ordner (Firmenlogo, Briefpapier-Hintergründe,
# Kunden-/Projektdateien, Dachflächen-Skizzen, Einsatzbericht-Fotos/
# -Unterschriften), falls sie nicht im Projektordner selbst liegen sollen.
# Auf einem Server WICHTIG: ein Ordner außerhalb des Checkouts, damit ein
# "git pull" nie Fotos, Unterschriften oder den Schlüssel selbst berührt:
# ERP_DATA_DIR=

# Die folgenden acht Variablen sind nur nötig, wenn EIN EINZELNER dieser
# Ordner an einem anderen Ort liegen soll als der Rest (der über
# ERP_DATA_DIR bestimmt wird) -- z. B. Einsatzbericht-Fotos auf einem
# separaten Volume. Im Normalfall bleiben alle acht unkommentiert/unbesetzt.
# DACHKONZEPTE_LOGO_FILE_ROOT=
# DACHKONZEPTE_SIDEBAR_LOGO_FILE_ROOT=
# DACHKONZEPTE_CUSTOMER_FILE_ROOT=
# DACHKONZEPTE_LAYOUT_BACKGROUND_ROOT=
# DACHKONZEPTE_PROJECT_FILE_ROOT=
# DACHKONZEPTE_ROOF_SKETCH_FILE_ROOT=
# DACHKONZEPTE_SIGNATURE_FILE_ROOT=
# DACHKONZEPTE_SERVICE_REPORT_PHOTO_ROOT=
