# Umgebung des Portal-Dienstes (seit 1.11.2) -- MUSTER OHNE WERTE. Auf dem Server: /etc/dk-portal/portal.env, 640 root:dkportal.
# Passwort und Schlüssel entstehen in den Server-Schritten S3 und S4 direkt in der Datei -- nie anzeigen, nie in ein Repo, nie in einen Bericht.
# Gelesen von app/portal/einstellungen.py::aus_umgebung(): fehlt etwas oder passt es nicht, startet der Dienst nicht.
DATABASE_URL=postgresql+psycopg://dkportal:<PASSWORT>@127.0.0.1:5432/dachkonzepte
PORTAL_HERKUNFT=https://kunde.dachkonzepte.gmbh
PORTAL_BREMSE_SCHLUESSEL=<64 HEXADEZIMALZEICHEN>
ERP_ENV=production
