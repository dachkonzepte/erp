# Postbote des Kundenportals (seit 1.11.6, Stufe P1c) -- schickt die Anmeldecodes, die das Portal anfordert, und räumt nach den Fristen auf.
# Läuft dauerhaft unter dem Benutzer des ERP (der Zugang zu Microsoft 365 und das Geheimnis des ERP bleiben dort; das Portal kennt beides nicht).
# Einrichten: docs/archiv/webseite-und-kundenportal.md, „Server-Schritte P1“ (S6). Lädt .env wie update.sh (set -a; source .env; set +a).
# Läuft schon ein Postbote (Sperre der Datenbank), endet ein zweiter mit Rückgabe 3.
# Seit 1.11.33 (Stufe P2b) legt er die Kopien der freigegebenen Unterlagen in PORTAL_DATEIEN (/srv/dk-portal/dateien, tobias:www-data 2750; aus .env).
# Fotos kodiert ein Kindprozess neu (app/portal_foto_kind.py) mit eigener Grenze für Speicher (RLIMIT_AS 1 GiB) und Zeit (60 s) -- er zählt zur Grenze
# dieser Einheit, deshalb MemoryHigh/MemoryMax höher als bis 1.11.32 (200M/256M). UMask 0027: neue Dateien höchstens für die Gruppe lesbar (www-data liest
# die Kopien über die Gruppe des Ordners, die Datei selbst setzt der Postbote auf 0640). ProtectSystem=full lässt /srv beschreibbar.
[Unit]
Description=ERP: Postbote des Kundenportals
After=network.target postgresql.service

[Service]
Type=simple
User=tobias
Group=tobias
WorkingDirectory=/home/tobias/erp
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/bash -c 'set -a; source .env; set +a; exec .venv/bin/python scripts/portal_postbote.py'
Restart=always
RestartSec=5
MemoryHigh=640M
MemoryMax=768M
UMask=0027
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
